# ─────────────────────────────────────────────────────── Application
RAG_ENV=dev
RAG_APP_NAME=advance-rag
RAG_LOG_LEVEL=INFO
RAG_LOG_JSON=false

# ─────────────────────────────────────────────────────── Infrastructure
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
RAG_REDIS_URL=redis://localhost:6379/0
RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=

# ─────────────────────────────────────────────────────── Object Storage
RAG_STORAGE_BACKEND=local
RAG_STORAGE_LOCAL_ROOT=./data/storage
# RAG_GCS_BUCKET=

# ─────────────────────────────────────────────────────── AI Providers
# GEMINI_API_KEY=                # or RAG_GEMINI_API_KEY — both work

# ─────────────────────────────────────────────────────── Operational
RAG_HEALTH_CHECK_TIMEOUT_S=2.0
